<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>osu.Game.Rulesets.O2Lazer.Tests</RootNamespace>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <NoWarn>$(NoWarn);MSB3277</NoWarn>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>
    <ItemGroup Label="Package References">
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0"/>
        <PackageReference Include="NUnit" Version="4.5.1"/>
        <PackageReference Include="NUnit3TestAdapter" Version="6.1.0"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\osu.Game.Rulesets.O2Lazer\osu.Game.Rulesets.O2Lazer.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <Compile Include="Normal\Core\**\*.cs" />
        <Compile Include="Normal\Clean\**\*.cs" />
    </ItemGroup>
    <ItemGroup Condition="'$(UseLocalOsuBinary)' == 'true'">
        <!-- Match the host's Realm helper dependency, not a separately shipped ruleset library.
             Keep the NuGet audit visible; see docs/development.md for the current advisory. -->
        <PackageReference Include="AutoMapper" Version="13.0.1" PrivateAssets="all" />
        <!-- Native APIMod annotations are reflected when ScoreInfo serialises replay settings. -->
        <PackageReference Include="MessagePack.Annotations" Version="3.1.7" PrivateAssets="all" />
        <Reference Include="osu.Game">
            <HintPath>$(OsuGameProjectPath)</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="osu.Game.Rulesets.Mania">
            <HintPath>$(OsuManiaAssemblyPath)</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="osu.Game.Resources">
            <HintPath>$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName('$(OsuGameProjectPath)')), 'osu.Game.Resources.dll'))</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>
</Project>
