root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

[*.{csproj,props,targets}]
indent_style = space
indent_size = 4

[*.{json,resx,slnx}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
